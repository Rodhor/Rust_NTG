# === APP ===
APP_NAME="Rust NTG"
APP_BIND_ADDR=127.0.0.1:8080
APP_URL=http://localhost:8080

# === LOG ===
LOG_LEVEL=debug
LOG_TARGET=file
LOG_FORMAT=pretty
LOG_FILE_PATH=logs/app.log

# === DATABASE ===
DATABASE_URL=sqlite:///app.db
DATABASE_POOL_SIZE=1
DATABASE_MAX_CONNECTIONS=1

# === SFTP ===
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_DEFAULT_IN_DIRECTORY=.
SFTP_DEFAULT_OUT_DIRECTORY=out
SFTP_DEFAULT_ARCHIVE_DIRECTORY=archive
