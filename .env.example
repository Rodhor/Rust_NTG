# === APP ===
APP_NAME="Rust NTG"
APP_BIND_ADDR=127.0.0.1:8080
APP_URL=http://localhost:8080

# === LOG ===
LOG_LEVEL=debug
LOG_TARGET=file
LOG_FORMAT=pretty
LOG_FILE_PATH=logs/app.log

# === DATABASE ===
DATABASE_URL=sqlite:///app.db
DATABASE_POOL_SIZE=1
DATABASE_MAX_CONNECTIONS=1

# === SFTP ===
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_REMOTE_ROOT_DIR=./
SFTP_LOCAL_ROOT_DIR=./data/sftp-transfer
SFTP_IN_DIR=in
SFTP_OUT_DIR=out
SFTP_ARCHIVE_DIR=archive
SFTP_CONNECT_TIMEOUT_SECS=10
SFTP_POOL_SIZE=2
# SHA256 fingerprint of the server host key, 64 hex chars, no "SHA256:" prefix.
# Derive it on the server:
#   ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub | awk '{print $2}' \
#     | sed 's/^SHA256://' | base64 -d | xxd -p -c 64
SFTP_HOST_KEY_SHA256=
