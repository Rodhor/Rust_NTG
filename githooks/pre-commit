#!/usr/bin/env bash
set -u

# sqlx offline-cache guard for pre-commit.
#
# Aborts the commit if the .sqlx cache is stale, i.e. you changed a
# query!/query_as! (or a migration) without regenerating the cache.
# The cache is checked into version control so builds work offline on
# every machine (see .cargo/config.toml: SQLX_OFFLINE).
#
# Fix when this fires:
#   cd crates/db && cargo sqlx prepare
#   git add crates/db/.sqlx
#
# Requires a local, migrated dev database (DATABASE_URL in the shell or
# in the repo's .env). If none is available the check is skipped.

repo_root="$(git rev-parse --show-toplevel)"

db_url="${DATABASE_URL:-}"
if [ -z "$db_url" ] && [ -f "$repo_root/.env" ]; then
  db_url="$(sed -n 's/^DATABASE_URL=//p' "$repo_root/.env" | head -n1)"
fi

if [ -z "$db_url" ]; then
  echo "sqlx pre-commit: DATABASE_URL not set and no .env found; skipping offline-cache check." >&2
  exit 0
fi

output="$(cd "$repo_root/crates/db" && cargo sqlx prepare --check --database-url "$db_url" 2>&1)"
status=$?

if [ "$status" -ne 0 ]; then
  echo "$output" >&2
  echo >&2
  echo "sqlx pre-commit: .sqlx offline cache is out of date." >&2
  echo "  Run:  cd crates/db && cargo sqlx prepare --database-url '$db_url'" >&2
  echo "  Then: git add crates/db/.sqlx" >&2
  exit 1
fi

exit 0